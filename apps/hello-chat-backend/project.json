{
  "name": "hello-chat-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/hello-chat-backend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/hello-chat-backend"],
      "defaultConfiguration": "production",
      "options": {
        "cwd": "apps/hello-chat-backend",
        "command": "sls package"
      },
      "configurations": {
        "development": {
          "command": "sls package --package=../../dist/apps/hello-chat-backend --stage=development"
        },
        "production": {
          "command": "sls package --package=../../dist/apps/hello-chat-backend --stage=production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/hello-chat-backend",
        "command": "sls offline"
      },
      "configurations": {
        "development": { "command": "sls offline --stage=development" },
        "production": { "command": "sls offline --stage=production" }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/hello-chat-backend",
        "command": "sls deploy"
      },
      "configurations": {
        "development": { "command": "sls deploy --stage=development" },
        "production": { "command": "sls deploy --stage=production" }
      },
      "dependsOn": [{ "target": "build" }]
    },
    "destroy": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/hello-chat-backend",
        "command": "sls remove"
      },
      "configurations": {
        "development": { "command": "sls remove --stage=development" },
        "production": { "command": "sls remove --stage=production" }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "defaultConfiguration": "ci",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/hello-chat-backend/jest.config.cts"
      }
    }
  }
}
